{
  "name": "@easythread/bun-plugin",
  "version": "0.1.0",
  "description": "Bun plugin for easythread - automatic Web Worker generation",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "keywords": [
    "bun",
    "plugin",
    "web-workers",
    "typescript",
    "easythread"
  ],
  "author": "Lekë Dobruna",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leka74/easythread.git",
    "directory": "packages/bun-plugin"
  },
  "homepage": "https://github.com/leka74/easythread#readme",
  "bugs": {
    "url": "https://github.com/leka74/easythread/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@easythread/core": "workspace:*"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}