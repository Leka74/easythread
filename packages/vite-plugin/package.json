{
  "name": "@easythread/vite",
  "version": "0.1.3",
  "description": "Vite plugin for easythread - automatic Web Worker generation",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "web-workers",
    "easythread"
  ],
  "author": "Lekë Dobruna",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leka74/easythread.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/leka74/easythread#readme",
  "bugs": {
    "url": "https://github.com/leka74/easythread/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@easythread/core": "workspace:*"
  },
  "devDependencies": {
    "vite": "^7.1.9",
    "tsup": "^8.0.0",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0"
  }
}